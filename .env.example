# Rename this file to .env and fill in your real values

# Your Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_key_here

# Azure Speech Services (Text-to-Speech) — from the Azure portal resource
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here   # e.g. centralindia, eastus

# Single admin login used at /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Any random string, used to sign session cookies
FLASK_SECRET_KEY=change-this-to-something-random
